{
  "schema_version": 1,
  "precedence": ["canonical-id", "alias", "intent", "context"],
  "ambiguity_policy": "ask-with-candidates",
  "package_health_policy": "last-known-good",
  "rules": [
    {"command": "stack.explore", "intents": ["explore", "idea", "strategy", "research"]},
    {"command": "stack.plan", "intents": ["plan", "brainstorm", "specification"]},
    {"command": "stack.design", "intents": ["design", "ui", "motion", "critique"]},
    {"command": "stack.design.intelligence", "subcommand": "collect", "intents": ["collect design inspiration", "collect design intelligence", "collect bookmarks"]},
    {"command": "stack.design.intelligence", "subcommand": "digest", "intents": ["digest design intelligence", "weekly design digest", "summarize design inspiration"]},
    {"command": "stack.design.intelligence", "subcommand": "retrieve", "intents": ["retrieve inspiration", "relevant inspiration", "show me relevant inspiration", "inspiration for this screen", "task context retrieval"], "requires_context": ["task-context"]},
    {"command": "stack.design.intelligence", "subcommand": "critique", "intents": ["design intelligence critique", "critique inspiration", "critique this reference"], "requires_context": ["task-context"]},
    {"command": "stack.design.intelligence", "subcommand": "propose", "intents": ["propose design improvement", "propose a skill update", "design intelligence proposal"]},
    {"command": "stack.build", "intents": ["implement", "build", "debug", "optimize"]},
    {"command": "stack.orchestrate", "intents": ["parallel goals", "delegate", "worktree", "handoff"]},
    {"command": "stack.review", "intents": ["code review", "architecture review", "security review"], "requires_context": ["code-or-architecture-artifact"]},
    {"command": "stack.qa", "intents": ["test browser", "ios qa", "accessibility", "canary"]},
    {"command": "stack.ship", "intents": ["commit", "pull request", "deploy", "release"]},
    {"command": "stack.learn", "intents": ["retro", "document learning"]},
    {"command": "stack.maintain", "intents": ["doctor", "install stack", "update stack", "audit stack"]},
    {"command": "stack.run", "intents": ["run full workflow", "end to end"]},
    {"command": "stack", "intents": ["help", "route", "status"]},
    {"command": "stack", "subcommand": "bookmarks", "intents": ["bookmark infrastructure", "x bookmark status", "bookmark status", "bookmark inspect", "bookmark preflight"]}
  ]
}
