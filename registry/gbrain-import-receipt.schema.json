{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stack.maroun.co/registry/gbrain-import-receipt.schema.json",
  "title": "x-bookmarks GBrain import receipt",
  "description": "Public-safe handoff receipt. GBrain source scope, idempotency, result mapping, retries, and canary state are explicit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "source", "mode", "snapshot_digest", "transport",
    "idempotency", "retry", "canary", "status", "accepted_count", "rejected_count",
    "pending_count", "failure"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_id": {"$ref": "#/$defs/opaque"},
    "source": {"const": "x-bookmarks"},
    "mode": {"enum": ["dry-run", "apply"]},
    "snapshot_digest": {"$ref": "#/$defs/digest"},
    "transport": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "source", "operation"],
      "properties": {"contract_version": {"const": "gbrain-cli-markdown-v1"}, "source": {"const": "x-bookmarks"}, "operation": {"const": "markdown_directory"}}
    },
    "idempotency": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "identity_count", "duplicate"],
      "properties": {"key": {"type": "string", "pattern": "^x-bookmarks:[a-f0-9]{64}$"}, "identity_count": {"type": "integer", "minimum": 0}, "duplicate": {"type": "boolean"}}
    },
    "retry": {
      "type": "object", "additionalProperties": false,
      "required": ["attempts", "max_attempts", "state"],
      "properties": {"attempts": {"type": "integer", "minimum": 0}, "max_attempts": {"type": "integer", "minimum": 1}, "state": {"enum": ["not_started", "none", "retried", "exhausted"]}}
    },
    "canary": {
      "type": "object", "additionalProperties": false,
      "required": ["state"],
      "properties": {"state": {"enum": ["not_run", "accepted", "indexed"]}, "identity": {"anyOf": [{"$ref": "#/$defs/opaque"}, {"type": "null"}]}, "source": {"const": "x-bookmarks"}}
    },
    "status": {"enum": ["prepared", "pending", "accepted", "indexed", "no_action", "rejected", "partial", "blocked", "failed"]},
    "accepted_count": {"type": "integer", "minimum": 0},
    "rejected_count": {"type": "integer", "minimum": 0},
    "pending_count": {"type": "integer", "minimum": 0},
    "failure": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["reason"], "properties": {"reason": {"type": "string"}}}]},
    "transport_result": {"type": "object", "additionalProperties": false, "properties": {"status": {"type": "string"}, "imported_count": {"type": "integer", "minimum": 0}, "accepted_count": {"type": "integer", "minimum": 0}, "accepted_id_digest": {"$ref": "#/$defs/digest"}, "rejected_count": {"type": "integer", "minimum": 0}, "rejected_id_digest": {"$ref": "#/$defs/digest"}, "skipped_count": {"type": "integer", "minimum": 0}, "error_count": {"type": "integer", "minimum": 0}, "chunks": {"type": "integer", "minimum": 0}, "total_files": {"type": "integer", "minimum": 0}, "retry_after_seconds": {"type": "integer", "minimum": 0, "maximum": 300}}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "opaque": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,32}:[a-f0-9]{16,64}$"}
  }
}
