{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stack.maroun.co/registry/stack-maintenance-receipt.schema.json",
  "title": "Stack maintenance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "run_id",
    "mode",
    "manual_audit",
    "observed_at",
    "input_fingerprint",
    "provider_refs",
    "catalog_digest",
    "policy_digest",
    "checkout_state",
    "changed_paths_digest",
    "checks",
    "pr_state",
    "approval_state",
    "cleanup_state",
    "thread_state",
    "terminal_classification",
    "receipt_persisted"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"const": "stack-maintenance"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "mode": {"enum": ["audit", "prepare"]},
    "manual_audit": {"type": "boolean"},
    "observed_at": {"type": "string", "format": "date-time"},
    "input_fingerprint": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "provider_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "ref_digest"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "ref_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "catalog_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "checkout_state": {"$ref": "#/$defs/state"},
    "changed_paths_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "checks": {"type": "object", "additionalProperties": true},
    "pr_state": {"$ref": "#/$defs/state"},
    "approval_state": {"$ref": "#/$defs/state"},
    "cleanup_state": {"$ref": "#/$defs/state"},
    "thread_state": {"$ref": "#/$defs/state"},
    "terminal_classification": {"enum": ["no_action", "prepared", "awaiting_approval", "blocked", "partial", "failed", "published"]},
    "receipt_persisted": {"const": true},
    "discovery": {"$ref": "#/$defs/discovery"},
    "result": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "reason_code": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "circuit": {"$ref": "#/$defs/state"},
    "manual_audit_cleared": {"type": "boolean"}
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {"status": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    },
    "digest_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "candidate"],
      "properties": {
        "current": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "candidate": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "identical": {"type": "boolean"}
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "provider_id",
        "provider_ref",
        "status",
        "old_pin",
        "new_pin",
        "old_pin_digest",
        "new_pin_digest",
        "source_tree_digest",
        "generated_manifest_digest",
        "output_semantic_digest",
        "changed_exports",
        "affected_runtimes",
        "release_evidence",
        "deprecation_evidence",
        "version_risk_class",
        "compatibility_evidence",
        "approval_owner",
        "last_known_good",
        "rollback_pointer"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "provider_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "provider_ref": {"type": "string", "pattern": "^https://"},
        "status": {"enum": ["no_action", "prepared", "blocked", "failed"]},
        "terminal_classification": {"enum": ["no_action", "prepared", "blocked", "failed"]},
        "reason_code": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "result": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "old_pin": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "new_pin": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "old_pin_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "new_pin_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "current_pin": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "candidate_pin": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "source_tree_digest": {"$ref": "#/$defs/digest_pair"},
        "generated_manifest_digest": {"$ref": "#/$defs/digest_pair"},
        "output_semantic_digest": {"$ref": "#/$defs/digest_pair"},
        "changed_exports": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "affected_runtimes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "affected_adapters": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "release_evidence": {"type": "object"},
        "deprecation_evidence": {"type": "object"},
        "version_risk_class": {"enum": ["none", "compatible", "major", "deprecation", "security", "license-or-terms", "cost-or-scope", "unknown"]},
        "risk_class": {"enum": ["none", "compatible", "major", "deprecation", "security", "license-or-terms", "cost-or-scope", "unknown"]},
        "compatibility_evidence": {"type": "object"},
        "approval_owner": {"type": "string", "minLength": 1},
        "approval_required": {"type": "boolean"},
        "candidate_evidence_pending": {"type": "boolean"},
        "candidate_evidence_complete": {"type": "boolean"},
        "last_known_good": {"type": "object"},
        "rollback_pointer": {"type": "object"},
        "source_observation": {"type": "object"},
        "checks": {"type": "object"},
        "unsafe_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
