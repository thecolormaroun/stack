{
  "version": 1,
  "decision_cap": 3,
  "dispositions": [
    "no-action",
    "evidence-attachment",
    "reference-update",
    "skill-update",
    "new-candidate-skill",
    "upstream-import-update"
  ],
  "accepted_licenses": ["Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "ISC", "MIT", "MPL-2.0"],
  "review_gates": ["provenance-review", "evaluation-review", "publication-review"],
  "evaluation": {
    "immutable_source_pin_required": true,
    "network": "deny",
    "ambient_credentials": "deny",
    "private_corpus_mounts": "deny",
    "writes": "temporary-workspace-only",
    "artifact_output_only": true
  },
  "allowed_evaluation_dependencies": [],
  "materialization": {
    "authorization_scope": "isolated-owner-local-patch-only",
    "allowed_providers": ["stack"],
    "allowed_packages": ["stack"],
    "allowed_roles": ["skill", "reference", "registry", "test", "documentation"],
    "allowed_change_kinds": ["reference-update", "skill-update", "registry-metadata", "test-support", "documentation"],
    "maximum_changed_files": 5,
    "maximum_total_bytes": 131072,
    "forbidden_prefixes": [
      "vendor/", "plugins/", "packages/", "package/", "skills/imported/", "registry/commands",
      "registry/routing-rules", "commands/", "routing/", "runtime/", "runtimes/",
      "config/runtime-targets", ".github/", ".git/"
    ],
    "forbid_deletion": true,
    "forbid_rename": true,
    "forbid_executable_paths": true,
    "privacy_scan": "required",
    "temporary_checkout": "disposable-local-clone-no-network",
    "active_checkout_write": false,
    "draft_pr_authority": false,
    "runtime_publication_authority": false
  },
  "publication": {
    "active_evidence_pointer_requires": [
      "merge-receipt", "compile-receipt", "install-receipt", "discovery-receipt",
      "rollback-receipt"
    ],
    "candidate_may_advance_pointer": false,
    "candidate_may_install": false,
    "candidate_may_publish": false
  },
  "automatic_weekly_design_promotion": {
    "state": "active",
    "authorization_contract": "weekly-design-auto-promotion-approved-v1",
    "allowed_path_patterns": [
      "skills/**/SKILL.md",
      "skills/**/references/**/*.md"
    ],
    "maximum_candidates_per_run": 1,
    "maximum_changed_files": 3,
    "maximum_total_bytes": 32768,
    "required_gates": [
      "material-evidence",
      "isolated-materialization",
      "frozen-design-eval",
      "full-repository-tests",
      "fresh-independent-review",
      "pull-request-ci",
      "merge-verification",
      "runtime-publication",
      "rollback-receipt"
    ],
    "pull_request": {
      "direct_main_commit": false,
      "draft": false,
      "automatic_merge": true,
      "head_digest_binding": true,
      "all_required_checks": true,
      "single_lineage_pr": true
    },
    "publication": {
      "merged_origin_main_only": true,
      "atomic_installer_only": true,
      "claude_and_codex_discovery_required": true,
      "rollback_receipt_required": true
    },
    "prohibited_effects": [
      "direct-main-commit",
      "vendor-or-imported-edit",
      "route-or-command-edit",
      "source-corpus-mutation",
      "credential-access",
      "paid-provider-fallback",
      "destructive-cleanup",
      "upstream-pin-change"
    ]
  }
}
