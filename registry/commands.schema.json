{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stack.maroun.co/registry/commands.schema.json",
  "title": "Stack logical command registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "commands"],
  "properties": {
    "schema_version": {"const": 1},
    "commands": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "family", "subcommands", "owner", "visibility", "trust_class", "effect_vector", "inputs", "outputs", "delegates", "runtimes", "aliases"],
        "properties": {
          "id": {"type": "string", "pattern": "^stack(?:\\.[a-z]+)*$"},
          "family": {"type": "string"},
          "subcommands": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$"}},
          "owner": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"enum": ["stack", "package"]}, "id": {"type": "string"}}},
          "visibility": {"enum": ["primary", "extended"]},
          "trust_class": {"enum": ["read-only", "local-mutation", "external-mutation", "costly", "irreversible"]},
          "effect_vector": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_read", "owner_local_write", "project_write", "external_write", "costly_use", "irreversible_action"],
            "properties": {
              "source_read": {"type": "boolean"},
              "owner_local_write": {"type": "boolean"},
              "project_write": {"type": "boolean"},
              "external_write": {"type": "boolean"},
              "costly_use": {"type": "boolean"},
              "irreversible_action": {"type": "boolean"}
            }
          },
          "inputs": {"type": "array", "items": {"type": "string"}},
          "outputs": {"type": "array", "items": {"type": "string"}},
          "delegates": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["provider", "command"], "properties": {"provider": {"type": "string"}, "command": {"type": "string"}}}},
          "runtimes": {"type": "object", "additionalProperties": false, "required": ["claude", "codex"], "properties": {"claude": {"type": "string", "minLength": 1}, "codex": {"type": "string", "minLength": 1}}},
          "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["name", "kind", "canonical_warning"], "properties": {"name": {"type": "string", "minLength": 1}, "kind": {"enum": ["legacy", "package-native", "runtime"]}, "canonical_warning": {"type": "boolean"}}}}
        }
      }
    }
  }
}
