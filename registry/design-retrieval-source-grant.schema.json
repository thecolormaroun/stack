{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stack://registry/design-retrieval-source-grant.schema.json",
  "title": "Owner-local x-bookmarks retrieval grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "grant_id", "owner_identity", "source",
    "target_identity", "locator_scopes", "expires_at",
    "egress_contract", "allowed_cli_versions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "grant_id": {"type": "string", "pattern": "^source-grant:[a-f0-9]{16,64}$"},
    "owner_identity": {"type": "string", "pattern": "^local-owner:[a-z0-9][a-z0-9-]*$"},
    "source": {"const": "x-bookmarks"},
    "target_identity": {"type": "string", "pattern": "^local-target:[a-z0-9][a-z0-9-]*$"},
    "locator_scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["bookmarks/", "bookmark-"]}
    },
    "expires_at": {"type": "string", "format": "date-time"},
    "egress_contract": {"const": "gbrain-keyword-fts-no-provider-v1"},
    "allowed_cli_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"const": "0.42.67.0"}
    }
  }
}
